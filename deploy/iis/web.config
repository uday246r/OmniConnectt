<?xml version="1.0" encoding="utf-8"?>
<!--
  OmniConnect on IIS — the Windows twin of deploy/nginx/conf.d/omniconnect.conf.

  Place this at the ROOT of the IIS site whose physical path contains an unpacked release:

      <site root>\index.html          (copied from host\<version>\index.html)
      <site root>\host\<version>\…
      <site root>\modules\<key>\<version>\…
      <site root>\web.config          (this file)

  index.html references its chunks by ABSOLUTE path (/host/1.0.0/assets/…), so `host` and `modules`
  must sit at the site root. Pointing the site at host\<version> instead makes every asset 404.

  Requires: URL Rewrite 2.1 + Application Request Routing 3.0 with "Enable proxy" ticked
  (ARR adds the x-powered-by: ARR/3.0 header you can check for), and the IIS "WebSocket Protocol"
  feature for the SignalR rules.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          1. Service-to-service routes are never reachable from outside, whatever prefix they arrive
             under: approval replay, the catalogue lookup, capability discovery, and the API explorers.

          This MUST stay the first rule. The reference nginx config uses a regex location for exactly
          this reason — it has to win over /api/<service>/, which would otherwise proxy these straight
          through to a backend that is only guarded by a shared internal key.
        -->
        <rule name="Block internal and explorer routes" stopProcessing="true">
          <match url="^api/[^/]+-service/(internal|permissions|swagger)(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 2. A remote is a module, not a page: refuse to serve one as HTML. -->
        <rule name="Modules are not pages" stopProcessing="true">
          <match url="^modules/.*/index\.html$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!--
          3. A MISSING file under a versioned build folder must fail as 404.

          Without this, the SPA fallback at the bottom answers a missing chunk with index.html and a
          200. The browser then gets text/html where it asked for JavaScript or CSS, and because
          X-Content-Type-Options is nosniff it refuses the response outright — a stylesheet silently
          never applies (the page renders unstyled) and a module fails with "Failed to load module
          script". Both look like application bugs and neither shows a 404 in the network tab, which is
          what makes this worth a rule of its own rather than trusting the fallback's conditions.

          nginx does this with `try_files $uri =404` and the same comment.
        -->
        <rule name="Versioned build files must exist" stopProcessing="true">
          <match url="^(host|modules)/" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 4. SignalR hub on AuthService (needs the WebSocket Protocol feature). -->
        <rule name="Auth Service Hubs" stopProcessing="true">
          <match url="^hubs/(.*)" />
          <action type="Rewrite" url="http://localhost:5155/hubs/{R:1}" />
        </rule>

        <!--
          5-8. Backends. Each keeps its own prefix: that prefix IS the service's path base
          (Hosting:PathBase), so the URL is /api/lead-service/api/leads and the service strips
          /api/lead-service itself. Do not "tidy" the prefix out of the rewrite target.

          Every /api/<service> rule must come before the bare /api rule below.
        -->
        <rule name="Lead Service API" stopProcessing="true">
          <match url="^api/lead-service/(.*)" />
          <action type="Rewrite" url="http://localhost:5046/api/lead-service/{R:1}" />
        </rule>

        <rule name="Customer360 Service API" stopProcessing="true">
          <match url="^api/customer360-service/(.*)" />
          <action type="Rewrite" url="http://localhost:5059/api/customer360-service/{R:1}" />
        </rule>

        <rule name="Products Service API" stopProcessing="true">
          <match url="^api/products-service/(.*)" />
          <action type="Rewrite" url="http://localhost:5266/api/products-service/{R:1}" />
        </rule>

        <!-- AuthService is published at the origin root's /api: its refresh cookie is scoped to /api/auth. -->
        <rule name="Auth Service API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5155/api/{R:1}" />
        </rule>

        <!-- 9. Existing files and folders pass through untouched. -->
        <rule name="Static Content" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!--
          10. Every other path is a client-side route of the host: serve the live index.html.
              /api, /hubs, /host and /modules are all handled above and can never reach this.
        -->
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api|hubs)/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <!--
        index.html is the release POINTER and is replaced in place by every deploy, so it must never be
        cached. The versioned folders below opt back into caching forever.
      -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!--
    A version folder is content-addressed by its own name and is never rewritten, so browsers may keep
    its files forever. This is also what lets a tab that already loaded an old build keep finding its
    chunks after a release.
  -->
  <location path="host">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="modules">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
