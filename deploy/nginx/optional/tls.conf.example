# TLS at this nginx. Use this ONLY when nothing in front of it terminates TLS (no cloud load balancer).
#
#   1. Put the certificate chain and key in deploy/certs/ (fullchain.pem, privkey.pem) — e.g. certbot.
#   2. Copy this file to deploy/nginx/conf.d/tls.conf and set server_name.
#   3. In deploy/.env set PUBLIC_HTTPS_PORT=443 and PUBLIC_PORT=80, and uncomment the certs volume and
#      the 8443 port in compose.yml.
#
# The plain-HTTP server in omniconnect.conf then only redirects (replace its "location /" with the
# redirect below). AuthService already issues its refresh cookie Secure in Production.

server {
    listen 8443 ssl;
    http2 on;
    server_name app.example.com;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:omni_tls:10m;
    ssl_session_timeout 1d;

    # Two years, subdomains included — only once every subdomain really is HTTPS-only.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Everything else is identical to the plain server: include its locations here.
    # (Move the locations of omniconnect.conf's public server into snippets/app-locations.conf and
    #  include that file from both servers.)
}

# Redirect for the plain server:
#   location / { return 301 https://$host$request_uri; }
