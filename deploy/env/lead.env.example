# LeadService — copy to deploy/env/lead.env (git-ignored).
ConnectionStrings__LeadDb=Host=<db-host>;Port=5432;Database=lead_service;Username=<user>;Password=<password>;SSL Mode=Require

Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

# = Internal__Services__LeadService__ApiKey in auth.env (used in both directions).
AuthService__InternalApiKey=
Internal__ApiKey=

# = Internal__CatalogApiKey in products.env. Reads the Marketplace catalogue for the lead form.
ProductsService__InternalApiKey=

Self__AppKey=lead
