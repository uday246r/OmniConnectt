# AuthService — copy to deploy/env/auth.env (git-ignored). Network addresses between services are set in
# compose.yml; this file holds what differs per environment, including every secret.

ConnectionStrings__AuthDb=Host=<db-host>;Port=5432;Database=auth_service;Username=<user>;Password=<password>;SSL Mode=Require

# RS256 key pair, single-line PEM with literal \n escapes (see SETUP.md). The PUBLIC key goes to every
# other service; the private key exists only here.
Jwt__SigningKeyPrivate=
Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

# Same origin: keep Lax and no cookie domain.
Auth__SameSite=Lax

# One key per caller (openssl rand -hex 32). Each backend's own env file carries the same value.
Internal__Services__LeadService__ApiKey=
Internal__Services__Customer360Service__ApiKey=
Internal__Services__ProductsService__ApiKey=
# The release pipeline: the only caller allowed to register/promote/roll back builds.
Internal__Services__ReleaseAgent__ApiKey=

# Optional: Google SSO (add the public origin as an Authorized JavaScript origin).
Google__ClientId=
Google__AllowedDomains=

# Optional: SMTP for invitations and password resets. AppBaseUrl is the public origin.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=OmniConnect
Smtp__AppBaseUrl=https://app.example.com

# Optional: Redis, for more than one AuthService replica (cache, locks, SignalR backplane).
# ConnectionStrings__Redis=redis:6379
