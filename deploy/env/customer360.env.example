# Customer360Service — copy to deploy/env/customer360.env (git-ignored).
ConnectionStrings__Customer360Db=Host=<db-host>;Port=5432;Database=customer360_service;Username=<user>;Password=<password>;SSL Mode=Require

# The external CRM this service proxies (real credentials; never commit them).
CrmApi__BaseUrl=
CrmApi__ClientId=
CrmApi__ClientSecret=

Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

# = Internal__Services__Customer360Service__ApiKey in auth.env.
AuthService__InternalApiKey=
Internal__ApiKey=
