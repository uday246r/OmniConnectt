# ProductsService — copy to deploy/env/products.env (git-ignored).
ConnectionStrings__DefaultConnection=Host=<db-host>;Port=5432;Database=products_service;Username=<user>;Password=<password>;SSL Mode=Require

Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

AuthService__ServiceName=ProductsService
# = Internal__Services__ProductsService__ApiKey in auth.env.
AuthService__InternalApiKey=
Internal__ApiKey=

# A SEPARATE secret, given to LeadService (its ProductsService__InternalApiKey): reading product names
# must never grant the right to apply approvals.
Internal__CatalogApiKey=

Self__AppKey=products
Self__DisplayName=Products & Marketplace
