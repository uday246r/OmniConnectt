# Compose-level settings for deploy/compose.yml. Copy to deploy/.env (git-ignored) — or, on a first
# install, let scripts/init-env.sh write it (and env/*.env) with freshly generated secrets.

# The public host name and the contact for certificate notices.
DOMAIN=omniconnect.example.com
LETSENCRYPT_EMAIL=it-team@example.com

# Who is the public edge:
#   none         nginx itself (a Linux host, or behind a cloud load balancer) — PUBLIC_BIND=0.0.0.0
#   local-proxy  a TLS proxy on the same machine (Windows Server: Caddy) — PUBLIC_BIND=127.0.0.1, so
#                only that proxy can reach nginx and its X-Forwarded-For can be believed
EDGE_PROXY=none
PUBLIC_BIND=0.0.0.0

# Where frontend builds live on this host. Each deploy ADDS version folders here; nothing is overwritten.
RELEASE_ROOT=/srv/omniconnect

# The single public port. Behind a cloud load balancer this is what it forwards to.
PUBLIC_PORT=80

# The private network the services share with nginx. They believe X-Forwarded-For only from it.
PROXY_SUBNET=172.30.0.0/24

# Container engine: podman (rootful — the production setup; the scripts re-run themselves with sudo)
# or docker. Unset: podman when installed.
CONTAINER_ENGINE=podman

# Backend images: <IMAGE_REGISTRY>/<service>:<tag>. The release pipeline sets the tags per release.
# Only bump the service you actually rebuilt: `up -d` recreates a container only when its image
# changes, so leaving the other three alone is what keeps a deploy from restarting the whole platform.
IMAGE_REGISTRY=ghcr.io/your-org/omniconnect
AUTH_TAG=1.1.0
LEAD_TAG=1.0.0
C360_TAG=1.0.0
PRODUCTS_TAG=1.0.0

# The release pipeline's own key for AuthService's /internal/releases API — the same value as
# Internal__Services__ReleaseAgent__ApiKey in env/auth.env. Generate with: openssl rand -hex 32
RELEASE_AGENT_KEY=

# PostgreSQL on this machine: set COMPOSE_PROFILES=localdb and a strong LOCAL_DB_PASSWORD (read once,
# when the database volume is first created). Leave both empty to use a managed database instead.
COMPOSE_PROFILES=
LOCAL_DB_PASSWORD=
