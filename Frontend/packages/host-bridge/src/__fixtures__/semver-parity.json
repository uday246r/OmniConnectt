{
  "description": "Shared cases for the host-bridge compatibility check. AuthService (SemVerRange.cs, SemVerParityTests) refuses to promote a remote whose requiredHostBridge the live host does not satisfy; the host (packages/host-bridge semver.ts) refuses to mount one. Both suites run every row, so the server and the browser can never disagree. Add a row whenever either implementation changes.",
  "cases": [
    { "version": "1.0.0", "range": "^1.0.0", "expected": true },
    { "version": "1.9.3", "range": "^1.0.0", "expected": true },
    { "version": "2.0.0", "range": "^1.0.0", "expected": false },
    { "version": "0.9.0", "range": "^1.0.0", "expected": false },
    { "version": "1.2.0", "range": "^1.2.0", "expected": true },
    { "version": "1.1.9", "range": "^1.2.0", "expected": false },
    { "version": "0.2.5", "range": "^0.2.3", "expected": true },
    { "version": "0.3.0", "range": "^0.2.3", "expected": false },
    { "version": "0.0.3", "range": "^0.0.3", "expected": true },
    { "version": "0.0.4", "range": "^0.0.3", "expected": false },
    { "version": "0.9.9", "range": "^0", "expected": true },
    { "version": "1.0.0", "range": "^0", "expected": false },
    { "version": "0.0.9", "range": "^0.0", "expected": true },
    { "version": "0.1.0", "range": "^0.0", "expected": false },
    { "version": "1.2.9", "range": "~1.2.0", "expected": true },
    { "version": "1.3.0", "range": "~1.2.0", "expected": false },
    { "version": "1.9.0", "range": "~1", "expected": true },
    { "version": "2.0.0", "range": "~1", "expected": false },
    { "version": "1.2.3", "range": "1.2.3", "expected": true },
    { "version": "1.2.4", "range": "1.2.3", "expected": false },
    { "version": "1.2.3", "range": "=1.2.3", "expected": true },
    { "version": "1.7.0", "range": "1.x", "expected": true },
    { "version": "2.0.0", "range": "1.x", "expected": false },
    { "version": "1.2.8", "range": "1.2.x", "expected": true },
    { "version": "1.3.0", "range": "1.2.x", "expected": false },
    { "version": "3.1.4", "range": "*", "expected": true },
    { "version": "2.5.0", "range": ">=1.2.0 <3.0.0", "expected": true },
    { "version": "3.0.0", "range": ">=1.2.0 <3.0.0", "expected": false },
    { "version": "1.1.0", "range": ">=1.2.0 <3.0.0", "expected": false },
    { "version": "1.2.0", "range": ">1.2.0", "expected": false },
    { "version": "1.2.0", "range": "<=1.2.0", "expected": true },
    { "version": "v1.4.0", "range": "^1.0.0", "expected": true },
    { "version": "1.4.0-beta.1", "range": "^1.0.0", "expected": true },
    { "version": "not-a-version", "range": "^1.0.0", "expected": false },
    { "version": "1.0.0", "range": "", "expected": false },
    { "version": "1.0.0", "range": "^banana", "expected": false }
  ]
}
