# Port for Vite preview server (Module Federation manifest is served here).
VITE_PREVIEW_PORT=5004

# Leave empty: the app calls /api/products-service/api on the host's own origin, proxied by the host
# dev server (and nginx in production). Set only to reach ProductsService on another origin, e.g.
# http://localhost:5266/api
VITE_API_BASE_URL=

# The key this app was registered under in Setup → Applications (permissions are remote.<key>.<module>).
VITE_APP_KEY=products
