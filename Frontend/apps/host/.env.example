# Copy to `.env` in this same folder. `.env` is git-ignored. Vite only exposes vars prefixed VITE_.

# Leave empty: AuthService is reached on the host's own origin (/api, /hubs), proxied by the dev server
# (apps/host/dev-proxy.ts) and by nginx in production. Set only to reach it on another origin, e.g.
# http://localhost:5155 — no trailing slash.
VITE_AUTH_SERVICE_URL=

# Optional — Google OAuth Client ID (same one configured in Backend/AuthService/.env's
# Google__ClientId). Leave blank to keep "Sign in with Google" showing an honest "not configured"
# state instead of a broken button.
VITE_GOOGLE_CLIENT_ID=
