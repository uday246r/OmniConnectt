# Copy to `.env` in this same folder. `.env` is git-ignored. Vite only exposes vars prefixed VITE_.

# Port for Vite preview server (Module Federation manifest is served here). Must match the
# ManifestUrl registered for this app in Setup > Applications once it is registered there.
VITE_PREVIEW_PORT=5003

# Backend Customer360Service base URL. Unlike EmployeeService/LeadService this service does not use
# UsePathBase — its controllers are mounted at the root, so no /api/... suffix belongs here.
VITE_API_BASE_URL=http://localhost:5059
