# Port for Vite preview server (Module Federation manifest is served here)
VITE_PREVIEW_PORT=5002

# Backend LeadService base URL (with /api/lead-service path base)
VITE_API_BASE_URL=http://localhost:5046/api/lead-service

# Country a new lead's phone number starts in (ISO 3166-1 alpha-2, e.g. MY, SG, IN). The person
# entering the lead can pick another country; this is only the starting choice.
VITE_DEFAULT_PHONE_COUNTRY=MY
