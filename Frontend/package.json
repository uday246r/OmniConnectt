{
  "name": "omniremit-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter host dev",
    "dev:all": "pnpm -r --parallel dev",
    "dev:host": "pnpm --filter host dev",
    "dev:lead": "pnpm --filter lead-mf dev",
    "dev:customer360": "pnpm --filter customer360-mf dev",
    "build": "pnpm --filter host build",
    "build:lead": "pnpm --filter lead-mf build",
    "build:customer360": "pnpm --filter customer360-mf build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
