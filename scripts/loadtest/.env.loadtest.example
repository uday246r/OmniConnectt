# Copy this file to .env.loadtest (git-ignored) and fill in a real, NON-administrator test
# account's credentials. Used by both http-load.mjs and autocannon-run.mjs.
#
# Create the account first: sign in as the seeded super admin (see SETUP.md), then
# Settings -> Users -> create a user with a read-level role (not Administrator), so the load
# test exercises real permission checks instead of the admin bypass.
LOADTEST_EMAIL=
LOADTEST_PASSWORD=
