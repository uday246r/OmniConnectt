# --- Node / pnpm / Frontend ---
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
dist-ssr/
**/dist-ssr/
*.tsbuildinfo
**/*.tsbuildinfo
pnpm-lock.yaml.bak
package-lock.json
*.local

# --- Environment files & Secrets (never commit credentials) ---
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!**/.env.loadtest.example

# --- .NET & Backend ---
bin/
**/bin/
obj/
**/obj/
publish/
**/publish/
Backend/**/*.user
Backend/*.Tests/bin/
Backend/*.Tests/obj/
**/TestResults/

# --- Database & Local Storage ---
*.db
*.db-shm
*.db-wal
**/*.db
Backend/**/AppData/Uploads/
**/AppData/Uploads/
**/uploads/

# --- Editors & OS ---
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
.DS_Store
Thumbs.db

# --- Logs ---
*.log
**/*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Scratch & Diagnostics ---
graphify-out/
scratch/

# Assembled frontend releases (Frontend/scripts/release/build.mjs) — artifacts, never source
Frontend/release/
