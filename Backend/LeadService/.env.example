ConnectionStrings__LeadDb=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5002
AuthService__BaseUrl=http://localhost:5155
# This service's own internal key: the value of Internal__Services__LeadService__ApiKey in
# Backend/AuthService/.env. The same key is used in both directions — presented to AuthService, and
# expected from AuthService when it replays an approved change here.
AuthService__InternalApiKey=
Internal__ApiKey=

# Where the product catalogue lives. Every product a lead can be taken for comes from Products &
# Marketplace, read server to server. The key is the value of Internal__CatalogApiKey in
# Backend/ProductsService/.env (a separate secret from that service's approval-replay key).
ProductsService__BaseUrl=http://localhost:5266
ProductsService__InternalApiKey=

# This service's own externally-reachable base URL (including the /api/lead-service path base set by
# UsePathBase in Program.cs), handed to AuthService as the CallbackUrl on every gated Lead mutation.
Self__PublicBaseUrl=http://localhost:5046/api/lead-service
# The key this app was registered under in Setup → Applications. The approval module keys derive from it
# (remote.<AppKey>.lead and remote.<AppKey>.fieldsettings); set Self__LeadModuleKey /
# Self__FieldSettingsModuleKey only to override them.
Self__AppKey=lead
# The RS256 public key matching AuthService's private key, single-line with literal 

# escapes (see SETUP.md section 4). Must be identical in all four services.
Jwt__SigningKeyPublic=

# Database connections kept open so the first request after a quiet spell does not pay a new TLS
# handshake (~2 s to a remote database). 0 disables; note open connections stop a serverless database
# from auto-suspending while this service runs.
Database__MinimumPoolSize=3
