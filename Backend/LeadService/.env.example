ConnectionStrings__LeadDb=Server=tcp:<your-server>.database.windows.net,1433;Initial Catalog=omniremit_lead;Persist Security Info=False;User ID=<user>;Password=<pass>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Jwt__Issuer=omniremit-auth-service
Jwt__Audience=omniremit-host
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5002
AuthService__BaseUrl=http://localhost:5155
# The shared platform-wide key this service presents to AuthService on internal calls.
# Generate one with `openssl rand -base64 32` and use the SAME value in all four services.
AuthService__InternalApiKey=

# Phase 2 Maker-Checker: the shared key AuthService must present when replaying an approved Lead
# mutation against THIS service's own internal/approvals/apply endpoint (same platform-wide key as
# AuthService__InternalApiKey above works fine in both directions).
Internal__ApiKey=

# This service's own externally-reachable base URL (including the /api/lead-service path base set by
# UsePathBase in Program.cs), handed to AuthService as the CallbackUrl on every gated Lead mutation.
Self__PublicBaseUrl=http://localhost:5046/api/lead-service
# The live PermissionFeature.Key AuthService synced for this service's "Lead" module (see
# PermissionsController.cs) — a runtime fact set by whoever registered this app in Setup →
# Applications, not something this service can derive on its own. Check Setup → Applications or
# GET api/checker-assignments/modules on AuthService for the real value.
Self__LeadModuleKey=
# Same idea, for the separate "FieldSettings" module (Field Settings gates independently of Lead).
Self__FieldSettingsModuleKey=
# The RS256 public key matching AuthService's private key, single-line with literal 

# escapes (see SETUP.md section 4). Must be identical in all four services.
Jwt__SigningKeyPublic=
