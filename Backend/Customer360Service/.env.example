# Copy to `.env` in this same folder and fill in real values. `.env` is git-ignored.
# ASP.NET Core config binds double-underscore-separated env vars to nested config keys,
# e.g. CrmApi__BaseUrl -> configuration["CrmApi:BaseUrl"].

# PostgreSQL connection string for THIS service's own database. Required — appsettings.json carries no default.
# Example shape: Host=localhost;Port=5432;Database=omniconnect_customer360;Username=postgres;Password=<pass>
ConnectionStrings__Customer360Db=

# External CRM system this service proxies to. ClientId/ClientSecret are real credentials — leave
# blank here and set them only in your local .env, never commit real values into this file.
CrmApi__BaseUrl=
CrmApi__ClientId=
CrmApi__ClientSecret=

# RS256 public key ONLY — must be the exact public counterpart of AuthService's Jwt__SigningKeyPrivate.
# This service validates tokens locally and never issues or forges them.
Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

# Browser origins allowed to call this API, as an indexed list.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5001
Cors__AllowedOrigins__2=http://localhost:5002
Cors__AllowedOrigins__3=http://localhost:5003

# Phase 2 Maker-Checker: this service's first-ever connection to AuthService's internal surface
# (central audit-log push + gating check/submit for Field Settings mutations).
AuthService__BaseUrl=http://localhost:5155
# This service's own internal key: the value of Internal__Services__Customer360Service__ApiKey in
# Backend/AuthService/.env. The same key is used in both directions.
AuthService__InternalApiKey=
Internal__ApiKey=

# This service's own externally-reachable base URL, handed to AuthService as the CallbackUrl on every
# gated Field Settings mutation submitted for approval.
Self__PublicBaseUrl=http://localhost:5059
# The live PermissionFeature.Key AuthService synced for this service's "fieldsettings" module (see
# PermissionsController.cs) — a runtime fact set by whoever registered this app in Setup →
# Applications, not something this service can derive on its own. This service must actually be
# registered there (with PermissionsSourceUrl pointing at its own /permissions endpoint) before
# gating can be exercised at all. Check Setup → Applications or GET api/checker-assignments/modules
# on AuthService for the real value.
Self__FieldSettingsModuleKey=

# Database connections kept open so the first request after a quiet spell does not pay a new TLS
# handshake (~2 s to a remote database). 0 disables; note open connections stop a serverless database
# from auto-suspending while this service runs.
Database__MinimumPoolSize=3
