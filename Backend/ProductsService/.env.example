# Copy this file to .env and fill in real values. .env is gitignored and must never be committed -
# it is the only place a database credential should live on your machine.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)

# PostgreSQL connection string (Npgsql format). Example shape for a hosted Postgres provider:
# Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;Channel Binding=Require
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=productmarketplace;Username=postgres;Password=changeme;SSL Mode=Disable"
