# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)

# PostgreSQL connection string (Npgsql format). Example shape for a hosted Postgres provider:
# Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true;Channel Binding=Require
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=productmarketplace;Username=postgres;Password=changeme;SSL Mode=Disable"

# The host platform's token. The public key is the same one every other service uses (single line, with
# literal \n escapes — see SETUP.md). Without it no request is accepted.
Jwt__SigningKeyPublic=
Jwt__Issuer=omniconnect-auth-service
Jwt__Audience=omniconnect-host

# Where AuthService lives, and this service's own internal key there: the value of
# Internal__Services__ProductsService__ApiKey in Backend/AuthService/.env. The same key is expected back
# from AuthService when it replays an approved change here.
AuthService__BaseUrl=http://localhost:5155
AuthService__ServiceName=ProductsService
AuthService__InternalApiKey=
Internal__ApiKey=

# The key Lead Management presents to read the catalogue (its ProductsService__InternalApiKey). A separate
# secret from Internal__ApiKey above, so reading product names never grants the right to apply approvals.
# Without it the catalogue answers 503 and the lead form cannot offer products.
Internal__CatalogApiKey=

# This service's externally reachable address (AuthService sends approved changes back to
# <PublicBaseUrl>/internal/approvals/apply), and the key it was registered under in Setup → Applications.
# Every permission it enforces is remote.<AppKey>.<module>:<Capability>.
Self__PublicBaseUrl=http://localhost:5266
Self__AppKey=products
Self__DisplayName=Products & Marketplace

# Browser origins allowed to call this API: the host shell, and this remote's own dev server.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5004

# Optional: where uploaded application documents are stored. Point every instance at the same shared
# volume when running more than one; unset, files go under the service's content root.
# Storage__UploadsPath=/mnt/omniconnect/products-uploads

# Database connections kept open so the first request after a quiet spell does not pay a new TLS
# handshake (~2 s to a remote database). 0 disables; note open connections stop a serverless database
# from auto-suspending while this service runs.
Database__MinimumPoolSize=3
