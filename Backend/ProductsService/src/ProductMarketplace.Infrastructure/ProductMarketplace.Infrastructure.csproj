<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Enables ASP.NET Core server types (IHttpContextAccessor, SignalR IHubContext) from a plain class library. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProductMarketplace.Domain\ProductMarketplace.Domain.csproj" />
    <ProjectReference Include="..\ProductMarketplace.Application\ProductMarketplace.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft.Extensions.Configuration/DependencyInjection abstractions are supplied by the
         Microsoft.AspNetCore.App framework reference above; referencing the packages as well only
         produced NU1510 build warnings. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
