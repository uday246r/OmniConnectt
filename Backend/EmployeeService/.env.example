# Copy to `.env` in this same folder and fill in real values. `.env` is git-ignored.
# ASP.NET Core config binds double-underscore-separated env vars to nested config keys,
# e.g. ConnectionStrings__EmployeeDb -> configuration["ConnectionStrings:EmployeeDb"].

# Neon Postgres connection string for THIS service's own database (never shared with AuthService or
# ModuleRegistry — each backend service owns its own database, no cross-service DB dependency).
# Example shape: Host=ep-xxxx.neon.tech;Database=employeeManagement;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__EmployeeDb=

# RS256 public key ONLY — must be the exact public counterpart of AuthService's Jwt__SigningKeyPrivate.
# This service validates tokens locally (no network call to AuthService per request) and never issues or forges them.
Jwt__SigningKeyPublic=
Jwt__Issuer=omniremit-auth-service
Jwt__Audience=omniremit-host

# Comma/array-bound allowed origins for CORS.
Cors__AllowedOrigins__0=http://localhost:5173

# How this service reaches AuthService's internal audit-log ingestion endpoint.
AuthService__BaseUrl=http://localhost:5155
# Must match Internal__ApiKey in Backend/AuthService/.env.
AuthService__InternalApiKey=

# Browser origins allowed to call this API, as an indexed list. Development reads these from
# appsettings.Development.json instead (http://localhost:5173), so this is only needed in production.
# No trailing slash; wildcards are not supported.
# Cors__AllowedOrigins__0=https://app.yourdomain.com

# Maker-Checker. Self__PublicBaseUrl is the address AuthService calls back on to replay an approved
# change, so it must be reachable from AuthService — not from the browser, and never derived from an
# incoming request's Host header. Self__EmployeeModuleKey is the PermissionFeature key this service's
# employee module is registered under; it must match what an administrator sees in Checker Assignment,
# since that is what decides whether the module is gated at all.
# Internal__ApiKey MUST match AuthService's own Internal__ApiKey — it is the shared secret AuthService
# presents on the replay callback.
Self__PublicBaseUrl=http://localhost:5285
Self__EmployeeModuleKey=remote.employee
Internal__ApiKey=
