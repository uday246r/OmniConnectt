<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!--
      The approval engine's selection logic — ResolveEligibleCheckerIdsAsync, TrySelectCheckerAsync,
      ReassignPendingRequestsForDepartingCheckerAsync — is `internal` because only two app services
      may call it, not because it is unimportant. It is in fact the part of Maker-Checker most worth
      testing directly: who is eligible to approve what, and what happens to a queue when its checker
      leaves. Testing it only through the public submit path would mean asserting on a chosen checker
      rather than on the candidate set that produced them.
    -->
    <InternalsVisibleTo Include="AuthService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8" />
    <!-- Pin transitive Microsoft.OpenApi past the 2.0.0 CVE pulled in by AspNetCore.OpenApi 10.0.9 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />

    <!-- Pin transitive MessagePack past the advisories in 2.5.187, which SignalR.StackExchangeRedis pulls in -->

    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The platform field-format engine, shared with every service that validates admin-configured formats. -->
    <ProjectReference Include="../Shared/OmniConnect.Validation/OmniConnect.Validation.csproj" />
    <Using Include="OmniConnect.Validation" />
  </ItemGroup>

</Project>
