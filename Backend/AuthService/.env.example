# Copy to `.env` in this same folder and fill in real values. `.env` is git-ignored.
# ASP.NET Core config binds double-underscore-separated env vars to nested config keys,
# e.g. ConnectionStrings__AuthDb -> configuration["ConnectionStrings:AuthDb"].

# Azure SQL Database connection string for THIS service's own database.
# Example shape: Server=tcp:<your-server>.database.windows.net,1433;Initial Catalog=omniremit_auth;Persist Security Info=False;User ID=<user>;Password=<pass>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
ConnectionStrings__AuthDb=

# RS256 key pair used to sign/verify access tokens. AuthService holds BOTH; ModuleRegistry is given
# only the public key (see Backend/ModuleRegistry/.env.example). Generate with, e.g.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Paste each PEM's contents on a single line with \n for newlines, or point to a file path — see
# Options/JwtOptions.cs for the exact expected format.
Jwt__SigningKeyPrivate=
Jwt__SigningKeyPublic=
Jwt__Issuer=omniremit-auth-service
Jwt__Audience=omniremit-host
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
# Hard cap on one sign-in session, from the original login and unaffected by activity. 0 disables it.
Jwt__AbsoluteSessionHours=8

# Comma/array-bound allowed origins for CORS (must match the frontend's real origin(s) exactly,
# credentials are enabled so wildcard "*" is not valid here).
Cors__AllowedOrigins__0=http://localhost:5173

# Domain/name for the httpOnly refresh-token cookie. Leave RefreshCookieDomain empty for localhost.
Auth__RefreshCookieDomain=
Auth__RefreshCookieName=omniremit_refresh

# SameSite mode for the refresh cookie: Lax (default) | Strict | None.
# Leave as Lax when the SPA shares a registrable domain with this API (app.example.com ->
# api.example.com is same-site, so Lax is sent and is the safer choice). Only set None when they are
# genuinely cross-site, e.g. a *.vercel.app frontend calling an API on a different domain — without
# it the browser withholds the cookie on refresh and the session silently drops moments after a
# successful login. None also requires a Secure cookie, which is enforced at startup.
Auth__SameSite=Lax

# Browser origins allowed to call this API, as an indexed list. Development reads these from
# appsettings.Development.json instead (http://localhost:5173), so this is only needed in
# production. No trailing slash. Wildcards are NOT supported — Vercel preview deployments get a new
# URL per commit and will therefore fail CORS against production, which is the intended behaviour.
# Cors__AllowedOrigins__0=https://app.yourdomain.com

# Shared secret ModuleRegistry must send back on its internal permission-feature sync calls.
# Must match AuthService__InternalApiKey in Backend/ModuleRegistry/.env.
Internal__ApiKey=

# AES-256 key protecting the one-time temporary password that a Create-User approval produces,
# from the moment the checker approves until the maker reveals it once. Without it, approving a
# gated user creation is refused (fail closed) rather than silently losing the password.
# Generate 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# Rotating this key makes any ALREADY-STORED, not-yet-revealed temp password unrecoverable (the
# reveal endpoint returns 410 and an administrator must re-create the account).
Security__TempPasswordKey=

# Google SSO — leave both blank to keep it off. While unconfigured the login page hides the SSO block
# entirely (no button, no "OR" divider, and Google's script is never requested), so the form reads as
# a deliberate password-only login. To turn it on: create an OAuth 2.0 Client ID in Google Cloud
# Console (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application),
# add your frontend origin (e.g. http://localhost:5173) as an Authorized JavaScript origin, then
# paste the Client ID below and list the email domain(s) allowed to sign in.
#
# BOTH must be set — an empty domain list means nobody can sign in, which is the safe default.
# Backend-only: the browser reads the Client ID from GET /api/auth/sso-config at runtime, so no
# frontend rebuild is needed. (VITE_GOOGLE_CLIENT_ID in the host's .env is no longer used.)
Google__ClientId=
Google__AllowedDomains=

# SMTP — leave blank to keep email off. When configured, a newly created user is emailed a
# single-use, time-limited link to choose their own password, instead of that password travelling by
# email. Unconfigured, no mail is attempted and account creation is unaffected: the maker still
# collects the temporary password from My Requests, which stays available either way.
#
# Smtp__AppBaseUrl is REQUIRED for mail to be attempted — invite links are built from it, and it
# cannot be inferred from the request because the Host header is attacker-controllable.
# For Google Workspace, Smtp__Password must be an App Password, not the account password.
# Leave Username/Password blank for an internal relay that trusts the host.
# Connections always use TLS: port 465 is implicit TLS, anything else requires a STARTTLS upgrade.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=OmniConnect
Smtp__AppBaseUrl=
Smtp__InviteValidHours=48
