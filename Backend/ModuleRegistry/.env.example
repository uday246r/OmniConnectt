# Copy to `.env` in this same folder and fill in real values. `.env` is git-ignored.

# Azure SQL Database connection string for THIS service's own database — never shared with AuthService.
# Example shape: Server=tcp:<your-server>.database.windows.net,1433;Initial Catalog=omniremit_registry;Persist Security Info=False;User ID=<user>;Password=<pass>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
ConnectionStrings__RegistryDb=

# RS256 public key ONLY — must be the exact public counterpart of AuthService's Jwt__SigningKeyPrivate.
# This service validates tokens for GET /api/remote-apps/for-sidebar but never issues or forges them.
Jwt__SigningKeyPublic=
Jwt__Issuer=omniremit-auth-service
Jwt__Audience=omniremit-host

# Comma/array-bound allowed origins for CORS.
Cors__AllowedOrigins__0=http://localhost:5173

# How this service reaches AuthService's internal permission-feature-sync AND Maker-Checker
# gating/submission endpoints (internal/approvals/*).
AuthService__BaseUrl=http://localhost:5155
# Must match Internal__ApiKey in Backend/AuthService/.env.
AuthService__InternalApiKey=

# Phase 2 Maker-Checker: the shared key AuthService must present when replaying an approved mutation
# against THIS service's own internal/approvals/apply endpoint. Can reuse the same value as
# AuthService__InternalApiKey above — it's the same platform-wide trust boundary in both directions.
Internal__ApiKey=

# This service's own externally-reachable base URL, handed to AuthService as the CallbackUrl on every
# gated remote-app mutation submitted for approval. Must be reachable FROM AuthService.
Self__PublicBaseUrl=http://localhost:5200

# Browser origins allowed to call this API, as an indexed list. Development reads these from
# appsettings.Development.json instead (http://localhost:5173), so this is only needed in production.
# No trailing slash; wildcards are not supported.
# Cors__AllowedOrigins__0=https://app.yourdomain.com
